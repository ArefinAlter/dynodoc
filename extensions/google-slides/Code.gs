/** Development Slides adapter. Native page-element IDs map to stable engine IDs
 * in private per-user bindings; accessibility descriptions are preserved. */
const DYNODOC_ORIGIN='https://app.dynodoc.online',DYNODOC_HOST='google-slides';
function onOpen(){SlidesApp.getUi().createAddonMenu().addItem('Open provenance','showDynodoc').addToUi();}
function onInstall(e){onOpen(e);}
function showDynodoc(){SlidesApp.getUi().showSidebar(HtmlService.createTemplateFromFile('Sidebar').evaluate().setTitle('Dynodoc provenance'));}
function include(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function scope_(expected){const doc=SlidesApp.getActivePresentation(),key='dynodoc.'+doc.getId();if(expected&&expected!==key)throw new Error('Return to the connected presentation.');return {doc:doc,key:key};}
function binding_(s){const props=PropertiesService.getUserProperties(),raw=props.getProperty(s.key+'.binding');if(!raw)return null;const m=JSON.parse(raw);let text='';for(let i=0;i<m.count;i++){const part=props.getProperty(s.key+'.binding.'+m.generation+'.'+i);if(part===null)throw new Error('Saved shape bindings are incomplete. Do not overwrite them.');text+=part;}return JSON.parse(text);}
function saveBinding_(s,value,previous){const lock=LockService.getUserLock();lock.waitLock(5000);try{if(JSON.stringify(binding_(s))!==JSON.stringify(previous))throw new Error('Another sidebar changed shape bindings. Reopen this sidebar.');const props=PropertiesService.getUserProperties(),key=s.key+'.binding',old=props.getProperty(key),text=JSON.stringify(value),generation=Utilities.getUuid(),parts=[];if(Utilities.newBlob(text).getBytes().length>100000)throw new Error('This development binding exceeds 100 KB. Use a smaller deck.');for(let i=0;i<text.length;i+=2000)parts.push(text.slice(i,i+2000));const created=[];try{parts.forEach((p,i)=>{const k=key+'.'+generation+'.'+i;props.setProperty(k,p);created.push(k);});props.setProperty(key,JSON.stringify({generation:generation,count:parts.length}));}catch(e){created.forEach(k=>props.deleteProperty(k));throw e;}if(old){const m=JSON.parse(old);for(let i=0;i<m.count;i++)props.deleteProperty(key+'.'+m.generation+'.'+i);}}finally{lock.releaseLock();}}
function shapes_(config,scopeKey,binding){const targets=config.targets;const s=scope_(scopeKey),slides=s.doc.getSlides(),saved=binding_(s),shapes=[],map=[];
  if(slides.length!==config.groups.length)throw new Error('Slides were inserted or removed. Use file push.');
  slides.forEach((slide,i)=>{const local=slide.getPageElements();if(local.some(e=>!['SHAPE','IMAGE'].includes(String(e.getPageElementType()))))throw new Error('Grouped, table or unsupported shapes require file push.');const text=local.filter(e=>String(e.getPageElementType())==='SHAPE');const ts=targets.filter(t=>t.groupIndex===i);if(text.length!==ts.length)throw new Error('Slide text shape structure changed. Use file push.');text.forEach((e,j)=>{shapes.push(e.asShape());map.push({native:e.getObjectId(),id:ts[j].id});});});
  const current={slides:slides.map(s=>s.getObjectId()),shapes:map};if(saved&&JSON.stringify(saved)!==JSON.stringify(current))throw new Error('Stable slide/shape identities changed. Use file push.');if(!binding&&!saved)throw new Error('Connect this presentation before capturing.');return {s:s,shapes:shapes,current:current,saved:saved};}
function blocks_(shapes,targets){return shapes.map((shape,i)=>({id:targets[i].id,field:'text',text:shape.getText().asString().replace(/\n$/,'')}));}
function bindDynodoc(blocks,config,scopeKey){const targets=config.targets;const result=shapes_(config,scopeKey,true),actual=blocks_(result.shapes,targets);if(!sameBlocks_(actual,blocks))throw new Error('This presentation differs from the chosen revision. Use file push.');saveBinding_(result.s,result.current,result.saved);return actual;}
function readDynodoc(config,scopeKey){const targets=config.targets;return blocks_(shapes_(config,scopeKey,false).shapes,targets);}
function applyDynodoc(expected,next,config,scopeKey){const targets=config.targets;const result=shapes_(config,scopeKey,false),actual=blocks_(result.shapes,targets);if(!sameBlocks_(actual,expected)||next.length!==actual.length||next.some((b,i)=>b.id!==actual[i].id||b.field!=='text'))throw new Error('The local file changed after preview. Capture again.');scope_(scopeKey);result.shapes.forEach((shape,i)=>{if(next[i].text!==expected[i].text)shape.getText().setText(next[i].text);});return readDynodoc(config,scopeKey);}
