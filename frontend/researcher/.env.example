# For local web development. Fill random secrets without committing .env.
# The web server checks all of this when it starts (one message lists every problem); a
# development server (`vite dev`) only warns. Secrets: at least 32 characters, random
# (`openssl rand -hex 32`), different from each other. A placeholder such as change-me is refused.
ENGINE_API_URL=http://127.0.0.1:8080
WEB_SERVICE_KEY=
SESSION_SECRET=
# Any secret may be a file instead: set NAME_FILE=/path and leave NAME empty (both set is an
# error). The file holds only the value; trailing line breaks are ignored; at most 16 KiB; on
# Unix it must not be readable by group or others unless DYNODOC_ALLOW_OPEN_SECRET_FILES=true.
# Applies to SESSION_SECRET, WEB_SERVICE_KEY, RESEND_API_KEY, GOOGLE_CLIENT_SECRET, CONVERTER_KEY, SMTP_PASSWORD.
# SESSION_SECRET_FILE=
# WEB_SERVICE_KEY_FILE=
# DYNODOC_ALLOW_OPEN_SECRET_FILES=true

# --- Mode ---
# hosted (default): the hosted service as it is today. selfhosted: no marketing pages (they
# answer 404), never indexed, no page metrics unless DYNODOC_TELEMETRY=on, CSP and metrics
# origins from ORIGIN instead of the hosted hostnames. selfhosted requires ORIGIN and WEB_SERVICE_KEY.
# DYNODOC_MODE=hosted
# The exact public origin: scheme, host, optional port, no trailing slash.
# ORIGIN=
# selfhosted only: further origins the same installation answers to (comma-separated, at most 8).
# DYNODOC_ALT_ORIGINS=
# selfhosted only: shown on the sign-in page and in the workspace footer.
# DYNODOC_BRAND_NAME=Dynodoc
# DYNODOC_ORG_NAME=
# Plain text, up to 2000 characters and 40 lines. Use DYNODOC_ORG_NOTICE or DYNODOC_NOTICE_FILE, not both.
# DYNODOC_ORG_NOTICE=
# DYNODOC_NOTICE_FILE=
# DYNODOC_SUPPORT_URL=mailto:helpdesk@example.org
# on | off. Default: on in hosted mode, off in selfhosted mode (the page sends nothing and
# /telemetry answers 404). On in selfhosted mode reports only to this installation.
# DYNODOC_TELEMETRY=
# on | off (default on). Off hides email sign-in and refuses requests for new emailed links.
# AUTH_EMAIL_LINK=on
DEV_AUTH=false
RESEND_API_KEY=
EMAIL_FROM=
# Mail for sign-in links and invitations: resend | smtp | none. Default: resend when
# RESEND_API_KEY is set, otherwise none. A self-hosted server with email sign-in on and no
# transport that can send does not start (set one, or AUTH_EMAIL_LINK=off). With smtp, the rules
# and the messages are in docs/SELF-HOSTED-DEPLOYMENT-GUIDE.md 7.2; check the settings with
# node scripts/check-mail.mjs --dir <directory holding this file as .env> --to you@example.org
# DYNODOC_MAIL_TRANSPORT=
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# tls (port 465) | starttls (port 587, default) | none-local (plain text, loopback or private address only)
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD_FILE=
# SMTP_FROM=docs@example.org
# SMTP_FROM_NAME=
# SMTP_REPLY_TO=
# PEM file of the authorities to trust instead of the built-in list (a private mail server).
# SMTP_CA_FILE=
# SMTP_TIMEOUT_SECONDS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel homepage only: link to the isolated workspace (no auth secrets required).
PUBLIC_WORKSPACE_URL=

# Optional comma-separated HTTPS remote origins allowed by Office-pane CSP.
CONNECTOR_ORIGINS=
