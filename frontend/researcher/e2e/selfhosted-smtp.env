# Mail settings of the self-hosted test server that sends through SMTP (selfhosted-smtp.spec.ts
# starts the mail server on this port; playwright.config.ts and ci-frontend.yml start the web
# server with these on top of selfhosted.env). The password belongs to this test only.
DYNODOC_MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=2526
SMTP_SECURITY=none-local
SMTP_USER=e2e-sender
SMTP_PASSWORD=e2e-only-relay-password-0123
SMTP_FROM=docs@acme.example.test
SMTP_FROM_NAME=Acme Docs
