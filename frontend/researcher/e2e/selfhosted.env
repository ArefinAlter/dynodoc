# Settings of the self-hosted test servers (playwright.config.ts starts them with these, and
# ci-frontend.yml loads the same file). The organisation notice comes from a file so the
# DYNODOC_NOTICE_FILE path is exercised too. Secrets and ORIGIN are added by whoever starts
# the server.
DYNODOC_MODE=selfhosted
DYNODOC_BRAND_NAME=Acme Docs
DYNODOC_ORG_NAME=Acme Research Ltd.
DYNODOC_NOTICE_FILE=e2e/fixtures/selfhosted-notice.txt
DYNODOC_SUPPORT_URL=mailto:records@acme.example.test
