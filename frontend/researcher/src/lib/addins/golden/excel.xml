<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPaneApp">
  <Id>87abb75b-2df9-5cd9-8ae0-aead44f7b2fa</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Acme Research Ltd.</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Acme Docs for Excel" />
  <Description DefaultValue="Connect this workbook to an Acme Docs project. Acme Docs records edits to existing cell values and formulas while this pane is open, sends them for review, and brings approved changes from your team back into the workbook." />
  <IconUrl DefaultValue="https://dynodoc.corp.example/connectors/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://dynodoc.corp.example/connectors/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://help.corp.example/desk" />
  <AppDomains><AppDomain>https://dynodoc.corp.example</AppDomain></AppDomains>
  <Hosts><Host Name="Workbook" /></Hosts>
  <Requirements><Sets DefaultMinVersion="1.13"><Set Name="ExcelApi" /></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://dynodoc.corp.example/connectors/excel" /></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts><Host xsi:type="Workbook"><DesktopFormFactor>
      <FunctionFile resid="Commands.Url" />
      <ExtensionPoint xsi:type="PrimaryCommandSurface"><OfficeTab id="TabHome"><Group id="Dynodoc.Group">
        <Label resid="Group.Label" /><Icon><bt:Image size="16" resid="Icon.16" /><bt:Image size="32" resid="Icon.32" /><bt:Image size="80" resid="Icon.80" /></Icon>
        <Control xsi:type="Button" id="Dynodoc.Open"><Label resid="Open.Label" />
          <Supertip><Title resid="Open.Label" /><Description resid="Open.Description" /></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16" /><bt:Image size="32" resid="Icon.32" /><bt:Image size="80" resid="Icon.80" /></Icon>
          <Action xsi:type="ShowTaskpane"><TaskpaneId>Dynodoc.Provenance</TaskpaneId><SourceLocation resid="Pane.Url" /></Action>
        </Control>
      </Group></OfficeTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="https://dynodoc.corp.example/connectors/assets/icon-16.png" /><bt:Image id="Icon.32" DefaultValue="https://dynodoc.corp.example/connectors/assets/icon-32.png" /><bt:Image id="Icon.80" DefaultValue="https://dynodoc.corp.example/connectors/assets/icon-80.png" /></bt:Images>
      <bt:Urls><bt:Url id="Commands.Url" DefaultValue="https://dynodoc.corp.example/connectors/commands.html" /><bt:Url id="Pane.Url" DefaultValue="https://dynodoc.corp.example/connectors/excel" /></bt:Urls>
      <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="Acme Docs" /><bt:String id="Open.Label" DefaultValue="Acme Docs" /></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Open.Description" DefaultValue="Sign in to connect this file to an Acme Docs project, send your changes for review and bring in the changes your team approved." /></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
