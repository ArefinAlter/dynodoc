  <SupportUrl DefaultValue="https://help.corp.example/desk" />
  <AppDomains><AppDomain>https://dynodoc.corp.example</AppDomain></AppDomains>
  <Hosts><Host Name="Document" /></Hosts>
  <Requirements><Sets DefaultMinVersion="1.3"><Set Name="WordApi" /></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://dynodoc.corp.example/connectors/word" /></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
