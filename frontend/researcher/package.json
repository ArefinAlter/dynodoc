{
  "name": "@dynodoc/researcher",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173",
    "gen:api": "openapi-typescript ../../openapi.yaml -o src/lib/api/openapi.d.ts && prettier --write src/lib/api/openapi.d.ts",
    "build": "vite build",
    "build:connectors": "node scripts/build-connectors.mjs",
    "check:connectors": "node scripts/build-connectors.mjs --check",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint . && pnpm check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit -- --run && pnpm test:e2e",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "bench:office": "node scripts/benchmark-office-import.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.7.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.7.0",
    "@types/papaparse": "^5.5.2",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.44.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.47.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-mathematics": "3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-unique-id": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xmldom/xmldom": "0.9.12",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "hyperformula": "^3.4.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "mammoth": "^1.12.3",
    "openapi-fetch": "^0.13.8",
    "openid-client": "^6.8.8",
    "pagedjs": "0.4.3",
    "papaparse": "^5.7.0",
    "pptxgenjs": "^4.0.1",
    "ulid": "^3.0.2",
    "web-vitals": "^6.2.2"
  }
}
