{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .codex/hooks/guard-destructive.js",
        "matcher": "sqlx|migrate-reset|docker compose down|docker volume|drop database|truncate table event|delete from event",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "node .codex/hooks/migration-edit-hint.js",
        "matcher": "Write|StrReplace|EditNotebook"
      }
    ]
  }
}
