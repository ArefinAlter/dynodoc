{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynodoc",
  "identifier": "online.dynodoc.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": ["launcher", "launcher-mobile"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dynodoc"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Verne Ltd.",
    "copyright": "Copyright Verne Ltd.",
    "category": "Productivity",
    "shortDescription": "Dynodoc desktop client",
    "longDescription": "Opens your Dynodoc workspace (hosted or self-hosted) in its own window and keeps a signing key for this computer in the operating system's key store.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
