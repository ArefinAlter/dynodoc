{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "description": "The bundled launcher page in the main window may call the app's own commands, on desktop. There is no `remote` section: a page loaded from a server gets no native access at all.",
  "local": true,
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-get-state",
    "allow-set-server",
    "allow-open-sign-in-link",
    "allow-start-browser-sign-in",
    "allow-tools-version",
    "allow-device-key-status",
    "allow-device-key-create",
    "allow-device-public-key",
    "allow-session-info",
    "allow-visitor-start",
    "allow-sign-out",
    "allow-api-get",
    "allow-api-send",
    "allow-svc-get",
    "allow-svc-send",
    "allow-prefs-load",
    "allow-prefs-save",
    "allow-local-status",
    "allow-local-create-profile",
    "allow-local-retry",
    "allow-local-open-folder",
    "allow-backup-export",
    "allow-backup-import",
    "allow-files-pick",
    "allow-file-read",
    "allow-file-export",
    "allow-folder-bind",
    "allow-folder-unbind",
    "allow-folder-status",
    "allow-watch-poll",
    "allow-watch-seen",
    "allow-agent-config",
    "allow-agent-config-set",
    "allow-agent-consent",
    "allow-agent-key-set",
    "allow-agent-key-clear",
    "allow-agent-key-status",
    "allow-agent-keys-unlock",
    "allow-agent-preview",
    "allow-agent-run",
    "allow-agent-tool-result",
    "allow-agent-cancel",
    "allow-agent-usage",
    "allow-agent-installed-status",
    "allow-accounts-list",
    "allow-account-add",
    "allow-account-remove",
    "allow-account-signin-start",
    "allow-account-signin-status",
    "allow-account-signin-cancel",
    "allow-account-signout",
    "allow-account-check",
    "allow-window-reload",
    "allow-devtools-open"
  ]
}
