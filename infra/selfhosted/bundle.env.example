# Settings of the bundle itself (not of the Dynodoc application). Append the lines you need to the
# .env that `generate-env` wrote; README.md explains each one. Nothing here is a secret.

# --- How the proxy gets its certificate. REQUIRED, no default. -----------------------------------
#   provided    your own certificate: put the chain (server certificate first) in tls/fullchain.pem
#               and the private key in tls/privkey.pem. The proxy refuses to start if they are wrong.
#   evaluation  a self-signed certificate made on this machine, for trying the product out.
#               NOT FOR PRODUCTION; browsers warn and Office add-ins refuse it.
#   acme        an automatic public certificate (HTTP-01). Also needs COMPOSE_PROFILES=acme,
#               DYNODOC_BIND=0.0.0.0 on a machine whose port 80 and 443 the internet can reach,
#               and the three DYNODOC_ACME_* lines below.
DYNODOC_TLS_MODE=

# --- Where the proxy listens. ------------------------------------------------------------------
# 127.0.0.1 = only this machine (the default). 0.0.0.0 = every network interface, which makes the
# service reachable from your network: a decision to take on purpose.
# DYNODOC_BIND=127.0.0.1
# DYNODOC_HTTP_PORT=80
# DYNODOC_HTTPS_PORT=443
# ORIGIN (above, from generate-env) must be exactly what people type, including a non-default
# port: https://docs.example.org:8443 if DYNODOC_HTTPS_PORT=8443.

# --- TLS details (all optional). ---------------------------------------------------------------
# Seconds the browser is told to insist on HTTPS. Default 31536000 (one year); 300 in evaluation mode.
# Use a short value for the first installation: a year-long pin cannot be undone from the server.
# DYNODOC_HSTS_MAX_AGE=31536000
# How often the proxy looks for a replaced certificate and reloads without downtime.
# DYNODOC_TLS_RELOAD_SECONDS=60

# --- acme mode only. ---------------------------------------------------------------------------
# COMPOSE_PROFILES=acme
# DYNODOC_ACME_EMAIL=admin@example.org
# Read the certificate authority's terms of service, then set this to true to accept them.
# DYNODOC_ACME_ACCEPT_TOS=false
# letsencrypt-staging to test (certificates browsers do not trust), then letsencrypt; or the URL
# of another ACME directory. No default: the choice is yours.
# DYNODOC_ACME_CA=letsencrypt-staging

# --- Images. -----------------------------------------------------------------------------------
# Where the images come from and which release. The defaults are what `docker compose build` makes.
# DYNODOC_IMAGE_REGISTRY=registry.example.org/dynodoc
# DYNODOC_VERSION=1.0.0
# Replace the PostgreSQL image only to change its patch version or digest (PostgreSQL 16 only).
# DYNODOC_POSTGRES_IMAGE=postgres:16@sha256:...
