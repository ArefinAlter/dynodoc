# Dynodoc web server (SvelteKit, adapter-node) for the self-hosted bundle.
#
# Build context: the repository root.
#   docker compose -f infra/selfhosted/compose.yml -f infra/selfhosted/compose.build.yml build web tools
#
# Two targets:
#   runtime  the web server (node build). DYNODOC_MODE=selfhosted is set by compose.yml.
#   tools    runtime plus the environment generator and checkers (scripts/dynodoc-env.mjs,
#            scripts/check-mail.mjs and the plain-JavaScript configuration and mail modules
#            they import). It is used by the one-shot `preflight` job and for operator
#            commands. It is not a second service: nothing long-running starts from it.
ARG NODE_IMAGE=node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

FROM ${NODE_IMAGE} AS build
WORKDIR /app
RUN npm install -g pnpm@10.34.5
COPY frontend/researcher/package.json frontend/researcher/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=dynodoc-pnpm-store \
    pnpm install --frozen-lockfile
COPY frontend/researcher/ ./
RUN pnpm build && pnpm prune --prod

FROM ${NODE_IMAGE} AS runtime
LABEL org.opencontainers.image.title="dynodoc-web" \
      org.opencontainers.image.description="Dynodoc web server (self-hosted bundle)" \
      org.opencontainers.image.vendor="Verne Ltd."
WORKDIR /app
COPY --from=build --chown=node:node /app/build ./build
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
# The bundle runs every Dynodoc container as 10001:10001 (compose.yml `user:`), so file ownership
# in the image does not matter: everything under /app is read-only for a non-owner.
USER node
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 BODY_SIZE_LIMIT=16M
EXPOSE 3000
CMD ["node", "build"]

FROM runtime AS tools
LABEL org.opencontainers.image.title="dynodoc-tools" \
      org.opencontainers.image.description="Dynodoc configuration checker (self-hosted bundle)"
COPY --from=build /app/scripts/dynodoc-env.mjs /app/scripts/check-mail.mjs /app/scripts/
COPY --from=build /app/src/lib/server/config/*.js /app/src/lib/server/config/
COPY --from=build /app/src/lib/server/mail/*.js /app/src/lib/server/mail/
