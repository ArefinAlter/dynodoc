# Copy to .env on the server, chmod 600. Never commit the configured file.
# Generate each secret independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
PASETO_LOCAL_KEY=
WEB_SERVICE_KEY=
SESSION_SECRET=
CONVERTER_KEY=
# Use the HTTPS workspace origin exactly, with no trailing slash.
ORIGIN=https://app.dynodoc.online
PUBLIC_API_BASE_URL=https://app.dynodoc.online
TOKEN_TTL_SECONDS=3600
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
