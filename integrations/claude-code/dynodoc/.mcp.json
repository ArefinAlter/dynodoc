{
  "mcpServers": {
    "dynodoc": {
      "command": "engine-cli",
      "args": [
        "mcp",
        "--remote",
        "${DYNODOC_REMOTE}",
        "--project",
        "${DYNODOC_PROJECT}",
        "--device-key",
        "${DYNODOC_KEY}"
      ],
      "env": {
        "DYNODOC_WRITE": "${DYNODOC_WRITE:-off}"
      }
    }
  }
}
