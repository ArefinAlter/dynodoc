dd/1 error code=idempotency_conflict hint="This request id was used with different content."
dd/1 error code=proposal_closed hint="The proposal is merged, declined or withdrawn."
dd/1 error code=conflict refs=7C02 hint="The edit overlaps a newer change; see status."
dd/1 error code=budget_exceeded retry_after=30 hint="Budget used up; retry after the delay."
dd/1 error code=rate_limited retry_after=5 hint="Too many requests; retry after the delay."
dd/1 error code=busy hint="Server busy; retry."
dd/1 error code=deadline_exceeded hint="Deadline exceeded; retry reads, retry writes with the same request id."
dd/1 error code=storage_limit hint="Shared history budget is full."
dd/1 error code=internal hint="Internal error; detail is logged, not returned."
